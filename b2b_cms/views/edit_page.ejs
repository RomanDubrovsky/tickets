<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page ? 'Редактировать страницу' : 'Создать страницу' %> - CMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">B2B Афиша CMS</a>
            <div class="d-flex">
                <a href="/" class="btn btn-outline-light btn-sm">Назад в дашборд</a>
            </div>
        </div>
    </nav>

    <div class="container max-w-lg mb-5" style="max-width: 800px;">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h4 class="mb-0"><%= page ? 'Редактирование страницы' : 'Новая страница' %></h4>
            </div>
            <div class="card-body">
                <form action="/page/save" method="POST">
                    <% if (page) { %>
                        <input type="hidden" name="id" value="<%= page.id %>">
                    <% } %>

                    <div class="mb-3">
                        <label class="form-label">Домен</label>
                        <select name="domain_id" class="form-select" required>
                            <% domains.forEach(function(domain) { %>
                                <option value="<%= domain.id %>" <%= (page && page.domain_id === domain.id) ? 'selected' : '' %>>
                                    <%= domain.name %>
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Внутреннее название (например, концерт Арии)</label>
                        <input type="text" name="title" class="form-control" value="<%= page ? page.title : '' %>" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Адрес страницы (Slug)</label>
                        <div class="input-group">
                            <span class="input-group-text">/</span>
                            <input type="text" name="slug" class="form-control" placeholder="my-event-name" value="<%= page ? page.slug : '' %>" required>
                        </div>
                        <div class="form-text">Оставьте <b>/</b> если это главная страница домена. Иначе впишите адрес, например <b>concert-2026</b>. Не используйте пробелы!</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Юридическое лицо (Код скрипта билетов)</label>
                        <select id="scriptChoiceSelect" name="script_choice" class="form-select">
                            <!-- Опции будут подгружаться через JS при смене домена -->
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Код билетов (Iframe сторонней системы, например: &lt;div id="tlFrameContainer"...&gt;)</label>
                        <textarea name="iframe_code" class="form-control font-monospace" rows="8" required placeholder='<div id="tlFrameContainer" data-start="https://www.ticketland.ru/iframe-direct-sale/..."></div>'><%= page ? page.iframe_code : '' %></textarea>
                    </div>

                    <div class="d-flex justify-content-end">
                        <a href="/" class="btn btn-secondary me-2">Отмена</a>
                        <button type="submit" class="btn btn-primary">Сохранить и опубликовать</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <script>
        // Данные доменов для JS
        const domainsData = <%- JSON.stringify(domains) %>;
        const pageScriptChoice = <%= page ? page.script_choice : 1 %>;
        
        const domainSelect = document.querySelector('select[name="domain_id"]');
        const scriptSelect = document.getElementById('scriptChoiceSelect');
        
        function updateScripts() {
            const domainId = parseInt(domainSelect.value);
            const domain = domainsData.find(d => d.id === domainId);
            
            scriptSelect.innerHTML = '';
            
            if (domain) {
                const opt1 = document.createElement('option');
                opt1.value = 1;
                opt1.textContent = domain.script_1_name || 'Юрлицо 1';
                if (pageScriptChoice === 1) opt1.selected = true;
                scriptSelect.appendChild(opt1);
                
                const opt2 = document.createElement('option');
                opt2.value = 2;
                opt2.textContent = domain.script_2_name || 'Юрлицо 2';
                if (pageScriptChoice === 2) opt2.selected = true;
                scriptSelect.appendChild(opt2);
            }
        }
        
        domainSelect.addEventListener('change', updateScripts);
        updateScripts(); // Инициализация при загрузке
    </script>
</body>
</html>
