<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page ? 'Редактировать страницу' : 'Создать страницу' %> - CMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #f8fafc;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        .guide-box {
            background: #eef2ff;
            border-left: 4px solid #4f46e5;
            border-radius: 6px;
            padding: 12px 16px;
            margin-bottom: 20px;
            font-size: 0.88rem;
            color: #3730a3;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
                <i class="bi bi-ticket-perforated-fill text-primary"></i>
                B2B Афиша CMS
            </a>
            <div class="d-flex">
                <a href="/<%= (page && page.domain_id) ? ('?domain_id=' + page.domain_id) : (selectedDomainId ? ('?domain_id=' + selectedDomainId) : '') %>" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Назад в дашборд
                </a>
            </div>
        </div>
    </nav>

    <div class="container max-w-lg mb-5" style="max-width: 800px;">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold"><%= page ? 'Редактирование страницы' : 'Новая страница' %></h4>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Инструкция менеджера</span>
            </div>
            <div class="card-body p-4">
                <!-- Справка для менеджера -->
                <div class="guide-box mb-4">
                    <div class="d-flex align-items-center mb-1">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Справка по действиям менеджера:</strong>
                    </div>
                    <ul class="mb-0 ps-3">
                        <li><strong>Адрес (Slug):</strong> пишется только латиницей без пробелов (например, <code>tsoy-rock</code>). Для главной страницы укажите <code>/</code>.</li>
                        <li><strong>Кассовый шлюз:</strong> выберите юрлицо (ИП или ООО), на которое будут поступать средства за продажу билетов с этой страницы.</li>
                        <li><strong>Код билетов:</strong> вставьте код виджета Ticketland (тег <code>&lt;div id="tlFrameContainer"...&gt;</code>) или произвольный HTML/iframe сторонней кассы.</li>
                    </ul>
                </div>

                <form action="/page/save" method="POST">
                    <% if (page) { %>
                        <input type="hidden" name="id" value="<%= page.id %>">
                    <% } %>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Домен *</label>
                        <select name="domain_id" class="form-select" required>
                            <% domains.forEach(function(domain) { %>
                                <% const isSelected = (page && page.domain_id === domain.id) || (!page && selectedDomainId === domain.id); %>
                                <option value="<%= domain.id %>" <%= isSelected ? 'selected' : '' %>>
                                    <%= domain.name %>
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Внутреннее название (например, Концерт группы Ария на Неве) *</label>
                        <input type="text" name="title" class="form-control" value="<%= page ? page.title : '' %>" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Адрес страницы (Slug) *</label>
                        <div class="input-group">
                            <span class="input-group-text">/</span>
                            <input type="text" name="slug" class="form-control font-monospace" placeholder="my-event-name" value="<%= page ? page.slug : '' %>" required>
                        </div>
                        <div class="form-text">Оставьте <b>/</b> если это главная страница домена. Иначе впишите латинский адрес, например <b>concert-2026</b>.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Юридическое лицо (Кассовый шлюз билетов) *</label>
                        <select id="scriptChoiceSelect" name="script_choice" class="form-select">
                            <!-- Опции будут подгружаться через JS при смене домена -->
                        </select>
                        <div class="form-text">Определяет, какой платежный шлюз и accessHash Ticketland будет активирован для этой страницы.</div>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                            <label class="form-label fw-semibold mb-0">Код билетов (Виджет или Iframe) *</label>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-primary active" id="btnModeNative" onclick="setWidgetMode('native')">
                                    <i class="bi bi-ship me-1"></i> Наш виджет (SVG)
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="btnModeTl" onclick="setWidgetMode('ticketland')">
                                    <i class="bi bi-ticket-perforated me-1"></i> Ticketland
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="btnModeCustom" onclick="setWidgetMode('custom')">
                                    <i class="bi bi-code-slash me-1"></i> Свой HTML
                                </button>
                            </div>
                        </div>

                        <!-- Native Widget Session Selector Helper -->
                        <div id="nativeSessionHelper" class="p-2 mb-2 bg-light border rounded">
                            <div class="row g-2 align-items-center">
                                <div class="col-md-8">
                                    <label class="form-label small text-muted mb-1 fw-semibold">Рейс для схемы теплохода:</label>
                                    <select id="nativeSessionSelect" class="form-select form-select-sm" onchange="applyNativeWidgetSnippet()">
                                        <% if (typeof sessions !== 'undefined' && sessions && sessions.length > 0) { %>
                                            <% sessions.forEach(s => { %>
                                                <option value="<%= s.id %>">
                                                    <%= s.start_time %> — <%= s.event_title %> (<%= s.venue_name %>)
                                                </option>
                                            <% }); %>
                                        <% } else { %>
                                            <option value="1">Тестовый рейс (по умолчанию)</option>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="col-md-4 text-end pt-3">
                                    <button type="button" class="btn btn-primary btn-sm w-100" onclick="applyNativeWidgetSnippet()">
                                        <i class="bi bi-arrow-down-circle me-1"></i> Вставить код
                                    </button>
                                </div>
                            </div>
                        </div>

                        <textarea id="iframeCodeTextarea" name="iframe_code" class="form-control font-monospace" rows="7" required placeholder='<div class="ship-ticket-widget" data-session-id="1"></div>'><%= page ? page.iframe_code : '' %></textarea>
                        <div class="form-text mt-1" id="widgetCodeHint">
                            Наш нативный виджет отображает интерактивную схему судна, столики и места, рассчитывает цену зон и принимает оплату напрямую.
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/<%= (page && page.domain_id) ? ('?domain_id=' + page.domain_id) : (selectedDomainId ? ('?domain_id=' + selectedDomainId) : '') %>" class="btn btn-secondary">Отмена</a>
                        <button type="submit" class="btn btn-primary px-4">Сохранить и опубликовать</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <script>
        const domainsData = <%- JSON.stringify(domains.map(d => ({ 
            id: d.id, 
            gateways: ((d.gateways && d.gateways.length > 0) ? d.gateways : [
                { id: 1, name: d.script_1_name || 'Юрлицо 1', code: d.script_1_code || '' },
                { id: 2, name: d.script_2_name || 'Юрлицо 2', code: d.script_2_code || '' }
            ]).map(g => ({
                id: g.id,
                name: g.name,
                code: g.code || ''
            }))
        }))).replace(/</g, '\\u003c') %>;
        
        function getGatewayToken(code) {
            if (!code) return '';
            const match = code.match(/accessHash:\s*["']([^"']+)["']/i);
            return match ? match[1] : '';
        }

        const pageScriptChoice = <%= (page && page.script_choice) ? page.script_choice : 1 %>;
        
        const domainSelect = document.querySelector('select[name="domain_id"]');
        const scriptSelect = document.getElementById('scriptChoiceSelect');
        
        function updateScripts() {
            const domainId = parseInt(domainSelect.value);
            const domain = domainsData.find(d => d.id === domainId);
            
            scriptSelect.innerHTML = '';
            
            if (domain && domain.gateways && domain.gateways.length > 0) {
                domain.gateways.forEach(gw => {
                    const opt = document.createElement('option');
                    opt.value = gw.id;
                    const token = getGatewayToken(gw.code);
                    const name = gw.name || ('Шлюз #' + gw.id);
                    opt.textContent = name + (token ? ` — ${token}` : ' (нет токена)');
                    if (gw.id === pageScriptChoice) {
                        opt.selected = true;
                    }
                    scriptSelect.appendChild(opt);
                });
            } else {
                const opt1 = document.createElement('option');
                opt1.value = 1;
                opt1.textContent = 'Основной кассовый шлюз';
                scriptSelect.appendChild(opt1);
            }
        }
        
        domainSelect.addEventListener('change', updateScripts);
        updateScripts();

        // Widget Mode Helpers
        function setWidgetMode(mode) {
            const btnNative = document.getElementById('btnModeNative');
            const btnTl = document.getElementById('btnModeTl');
            const btnCustom = document.getElementById('btnModeCustom');
            const helper = document.getElementById('nativeSessionHelper');
            const textarea = document.getElementById('iframeCodeTextarea');
            const hint = document.getElementById('widgetCodeHint');

            btnNative.className = 'btn btn-outline-secondary';
            btnTl.className = 'btn btn-outline-secondary';
            btnCustom.className = 'btn btn-outline-secondary';

            if (mode === 'native') {
                btnNative.className = 'btn btn-outline-primary active';
                helper.style.display = 'block';
                hint.textContent = 'Наш нативный виджет отображает интерактивную схему судна, столики и места, рассчитывает цену зон и принимает оплату напрямую.';
                applyNativeWidgetSnippet();
            } else if (mode === 'ticketland') {
                btnTl.className = 'btn btn-outline-primary active';
                helper.style.display = 'none';
                hint.textContent = 'Виджет Ticketland: вставьте полученный в Ticketland контейнер <div id="tlFrameContainer" data-start="..."></div>';
                if (!textarea.value.includes('tlFrameContainer')) {
                    textarea.value = '<div id="tlFrameContainer" data-start="https://spb.ticketland.ru/iframe-direct-sale/..."></div>';
                }
            } else {
                btnCustom.className = 'btn btn-outline-primary active';
                helper.style.display = 'none';
                hint.textContent = 'Произвольный HTML-код или iframe сторонней билетной системы.';
            }
        }

        function applyNativeWidgetSnippet() {
            const sel = document.getElementById('nativeSessionSelect');
            const sessId = sel ? sel.value : '1';
            const textarea = document.getElementById('iframeCodeTextarea');
            if (textarea) {
                textarea.value = `<!-- Интерактивная схема теплохода -->\n<div class="ship-ticket-widget" data-session-id="${sessId}"></div>\n<link rel="stylesheet" href="/css/ship_widget.css">\n<script src="/js/ship_widget.js"><\/script>`;
            }
        }

        // Initialize state based on existing content
        const initialCode = document.getElementById('iframeCodeTextarea').value;
        if (initialCode.includes('tlFrameContainer')) {
            setWidgetMode('ticketland');
        } else if (initialCode.includes('ship-ticket-widget')) {
            setWidgetMode('native');
        } else if (initialCode.trim().length > 0) {
            setWidgetMode('custom');
        } else {
            setWidgetMode('native');
        }
    </script>
</body>
</html>
