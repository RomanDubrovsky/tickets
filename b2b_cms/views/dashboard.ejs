                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-3">Программа / Рейс</th>
                                                <th>Партнер (Промокод)</th>
                                                <th>Покупатель</th>
                                                <th>Сумма заказа</th>
                                                <th>Вознаграждение</th>
                                                <th class="pe-3 text-end">Дата</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (!agentSales || agentSales.length === 0) { %>
                                                <tr><td colspan="6" class="text-center py-4 text-muted">Продажи по промокодам пока отсутствуют</td></tr>
                                            <% } else { %>
                                                <% agentSales.forEach(function(sale) { %>
                                                    <tr>
                                                        <td class="ps-3">
                                                            <div class="fw-bold text-dark"><%= sale.event_title || 'Концерт на теплоходе' %></div>
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-light text-dark border"><%= sale.agent_name %></span>
                                                            <span class="font-monospace small text-primary ms-1"><%= sale.promo_code %></span>
                                                        </td>
                                                        <td><%= sale.customer_name || 'Покупатель' %></td>
                                                        <td><strong><%= sale.amount %> ₽</strong></td>
                                                        <td><strong class="text-success">+<%= sale.commission_amount %> ₽</strong></td>
                                                        <td class="pe-3 text-end text-muted small"><%= sale.created_at %></td>
                                                    </tr>
                                                <% }); %>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>

                            <!-- TAB 4: VENUES -->
                            <% } else if (activeTab === 'venues') { %>
                                <div class="guide-box">
                                    <i class="bi bi-info-circle-fill me-2"></i>
                                    <strong>Инструкция по площадкам:</strong> Площадки определяют судно и причал посадки пассажиров. Адрес причала и вместимость автоматически отображаются в карточках афиши и на страницах покупки билетов.
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold mb-0">Площадки, теплоходы и причалы</h5>
                                    <button class="btn btn-success btn-sm px-3" data-bs-toggle="modal" data-bs-target="#addVenueModal">
                                        <i class="bi bi-plus-lg"></i> Добавить площадку
                                    </button>
                                </div>

                                <div class="row g-3">
                                    <% venues.forEach(function(vn) { %>
                                        <div class="col-md-6">
                                            <div class="card p-3 border shadow-sm h-100">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <h6 class="fw-bold text-dark mb-0"><%= vn.name %></h6>
                                                    <form action="/venue/delete/<%= vn.id %>" method="POST" onsubmit="return confirm('Удалить площадку <%= vn.name %>?');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Удалить"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                </div>
                                                <div class="small text-muted mb-2">📍 <%= vn.pier_address || 'Адрес причала не указан' %></div>
                                                <div class="small text-secondary mb-2">Пассажировместимость: <strong><%= vn.capacity %> чел.</strong></div>
                                                <p class="small text-muted mb-0"><%= vn.description || '' %></p>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>

                                <!-- Add Venue Modal -->
                                <div class="modal fade" id="addVenueModal" tabindex="-1">
                                    <div class="modal-dialog">
                                        <form action="/venue/save" method="POST" class="modal-content">
                                            <input type="hidden" name="domain_id" value="<%= currentDomain.id %>">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Новая площадка / теплоход</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Название площадки / судна *</label>
                                                    <input type="text" class="form-control" name="name" placeholder="Теплоход «Рок Хит Нева»" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Адрес причала *</label>
                                                    <input type="text" class="form-control" name="pier_address" placeholder="Санкт-Петербург, Набережная Макарова, 34" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Вместимость (пассажиров)</label>
                                                    <input type="number" class="form-control" name="capacity" value="120">
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Описание</label>
                                                    <textarea class="form-control" name="description" rows="2"></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                                                <button type="submit" class="btn btn-success">Добавить</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>

                            <!-- TAB 5: PAGES -->
                            <% } else if (activeTab === 'pages') { %>
                                <div class="guide-box">
                                    <i class="bi bi-info-circle-fill me-2"></i>
                                    <strong>Инструкция по страницам:</strong> Здесь отображаются сгенерированные целевые страницы сайта (главная и страницы отдельных концертов). Вы можете отредактировать оформление или напрямую изменить вставленный iframe-виджет.
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold mb-0">Страницы домена <%= currentDomain.name %></h5>
                                    <a href="/page/add?domain_id=<%= currentDomain.id %>" class="btn btn-success btn-sm px-3">
                                        <i class="bi bi-plus-lg"></i> Добавить страницу
                                    </a>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-hover align-middle border">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 45%;">Название страницы</th>
                                                <th style="width: 35%;">Адрес (URL)</th>
                                                <th style="width: 20%;" class="text-end">Действия</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% pages.forEach(function(page) { %>
                                                <tr>
                                                    <td>
                                                        <div class="fw-semibold text-dark"><%= page.title %></div>
                                                        <% if (page.slug === '/') { %>
                                                            <span class="badge bg-info-subtle text-info border border-info-subtle" style="font-size: 0.7rem;">Главная страница (Афиша)</span>
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <% const pagePath = page.slug === '/' ? '' : page.slug.replace(/^\/+|\/+$/g, ''); %>
                                                        <a href="http://<%= page.domain_name %>/<%= pagePath %>" target="_blank" class="font-monospace small text-decoration-none">
                                                            /<%= pagePath %> <i class="bi bi-box-arrow-up-right"></i>
                                                        </a>
                                                    </td>
                                                    <td class="text-end">
                                                        <a href="/page/edit/<%= page.id %>" class="btn btn-sm btn-outline-primary me-1">Изменить</a>
                                                        <form action="/page/delete/<%= page.id %>" method="POST" class="d-inline" onsubmit="return confirm('Удалить страницу «<%= page.title %>»?');">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>

                            <!-- TAB 6: SETTINGS & GATEWAYS -->
                            <% } else if (activeTab === 'settings') { %>
                                <div class="guide-box">
                                    <i class="bi bi-info-circle-fill me-2"></i>
                                    <strong>Инструкция по кассовым шлюзам & брендингу:</strong> 
                                    <ul class="mb-0 ps-3 mt-1">
                                        <li><strong>Кассовые шлюзы:</strong> позволяют принимать оплату на разные юрлица (ИП Юницына, ООО Морские Корабли). В поле JS-кода вставляется конфигурация <code>TLConf</code> с ключом <code>accessHash</code>.</li>
                                        <li><strong>Глобальные счетчики:</strong> счетчики Яндекс.Метрики и Google Analytics подключаются один раз и работают на всех страницах сайта.</li>
                                    </ul>
                                </div>

                                <form action="/domain/edit" method="POST">
                                    <input type="hidden" name="domain_id" value="<%= currentDomain.id %>">
                                    <h5 class="fw-bold mb-3">Оформление & Дизайн</h5>
                                    
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold">Основной цвет бренда (HEX)</label>
                                            <input type="color" class="form-control form-control-color w-100" name="primary_color" value="<%= currentDomain.primary_color || '#0d6efd' %>">
                                        </div>
                                        <div class="col-md-8">
                                            <label class="form-label fw-semibold">URL логотипа</label>
                                            <input type="text" class="form-control" name="logo_url" value="<%= currentDomain.logo_url || '' %>" placeholder="https://...">
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-semibold">Глобальные счетчики (Метрика, Аналитика)</label>
                                            <textarea class="form-control font-monospace" name="global_scripts" rows="3"><%= currentDomain.global_scripts %></textarea>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-semibold">Реквизиты и текст в подвале (Юрлицо, ОГРН, ИНН)</label>
                                            <textarea class="form-control" name="footer_text" rows="3"><%= currentDomain.footer_text || '' %></textarea>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h5 class="fw-bold mb-0">Кассовые шлюзы Ticketland / SDK</h5>
                                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="addGatewayCard('<%= currentDomain.id %>')">+ Добавить шлюз</button>
                                    </div>

                                    <div id="gatewaysContainer<%= currentDomain.id %>" class="d-flex flex-column gap-3 mb-4">
                                        <% (currentDomain.gateways || []).forEach(function(gw, idx) { %>
                                            <div class="card bg-light border p-3 gateway-item" data-id="<%= gw.id %>">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="fw-semibold text-primary small">Кассовый шлюз #<span class="gw-num"><%= idx + 1 %></span></span>
                                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeGatewayCard(this)">Удалить</button>
                                                </div>
                                                <input type="hidden" name="gateway_id" value="<%= gw.id %>">
                                                <div class="mb-2">
                                                    <label class="form-label small fw-semibold mb-1">Название юр. лица / шлюза</label>
                                                    <input type="text" class="form-control form-control-sm" name="gateway_name" value="<%= gw.name %>" required>
                                                </div>
                                                <div>
                                                    <label class="form-label small fw-semibold mb-1">JS-код вызова шлюза (TLConf / SDK)</label>
                                                    <textarea class="form-control form-control-sm font-monospace" name="gateway_code" rows="3"><%= gw.code %></textarea>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>

                                    <button type="submit" class="btn btn-primary px-4">Сохранить настройки домена</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function addGatewayCard(domainId) {
            const container = document.getElementById('gatewaysContainer' + domainId);
            const count = container.querySelectorAll('.gateway-item').length + 1;
            const nextId = Date.now();
            
            const card = document.createElement('div');
            card.className = 'card bg-light border p-3 gateway-item';
            card.setAttribute('data-id', nextId);
            card.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-semibold text-primary small">Кассовый шлюз #<span class="gw-num">${count}</span></span>
                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeGatewayCard(this)">Удалить</button>
                </div>
                <input type="hidden" name="gateway_id" value="${nextId}">
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Название юр. лица / шлюза</label>
                    <input type="text" class="form-control form-control-sm" name="gateway_name" value="Шлюз ${count}" required>
                </div>
                <div>
                    <label class="form-label small fw-semibold mb-1">JS-код вызова шлюза (TLConf / SDK)</label>
                    <textarea class="form-control form-control-sm font-monospace" name="gateway_code" rows="3"></textarea>
                </div>
            `;
            container.appendChild(card);
        }

        function removeGatewayCard(btn) {
            const card = btn.closest('.gateway-item');
            const container = card.parentElement;
            if (container.querySelectorAll('.gateway-item').length <= 1) {
                alert('У домена должен оставаться хотя бы один кассовый шлюз.');
                return;
            }
            card.remove();
            container.querySelectorAll('.gateway-item').forEach((item, index) => {
                const numSpan = item.querySelector('.gw-num');
                if (numSpan) numSpan.textContent = index + 1;
            });
        }
    </script>
</body>
</html>
