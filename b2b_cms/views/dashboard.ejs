                                </div>

                                <form action="/domain/edit" method="POST">
                                    <input type="hidden" name="domain_id" value="<%= currentDomain.id %>">
                                    <h5 class="fw-bold mb-3">Оформление & Дизайн</h5>
                                    
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold">Основной цвет бренда (HEX)</label>
                                            <input type="color" class="form-control form-control-color w-100" name="primary_color" value="<%= currentDomain.primary_color || '#0d6efd' %>">
                                        </div>
                                        <div class="col-md-8">
                                            <label class="form-label fw-semibold">URL логотипа</label>
                                            <input type="text" class="form-control" name="logo_url" value="<%= currentDomain.logo_url || '' %>" placeholder="https://...">
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-semibold">Глобальные счетчики (Метрика, Аналитика)</label>
                                            <textarea class="form-control font-monospace" name="global_scripts" rows="3"><%= currentDomain.global_scripts %></textarea>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-semibold">Реквизиты и текст в подвале (Юрлицо, ОГРН, ИНН)</label>
                                            <textarea class="form-control" name="footer_text" rows="3"><%= currentDomain.footer_text || '' %></textarea>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h5 class="fw-bold mb-0">Кассовые шлюзы Ticketland / SDK</h5>
                                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="addGatewayCard('<%= currentDomain.id %>')">+ Добавить шлюз</button>
                                    </div>

                                    <div id="gatewaysContainer<%= currentDomain.id %>" class="d-flex flex-column gap-3 mb-4">
                                        <% (currentDomain.gateways || []).forEach(function(gw, idx) { %>
                                            <div class="card bg-light border p-3 gateway-item" data-id="<%= gw.id %>">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="fw-semibold text-primary small">Кассовый шлюз #<span class="gw-num"><%= idx + 1 %></span></span>
                                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeGatewayCard(this)">Удалить</button>
                                                </div>
                                                <input type="hidden" name="gateway_id" value="<%= gw.id %>">
                                                <div class="mb-2">
                                                    <label class="form-label small fw-semibold mb-1">Название юр. лица / шлюза</label>
                                                    <input type="text" class="form-control form-control-sm" name="gateway_name" value="<%= gw.name %>" required>
                                                </div>
                                                <div>
                                                    <label class="form-label small fw-semibold mb-1">JS-код вызова шлюза (TLConf / SDK)</label>
                                                    <textarea class="form-control form-control-sm font-monospace" name="gateway_code" rows="3"><%= gw.code %></textarea>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>

                                    <button type="submit" class="btn btn-primary px-4">Сохранить настройки домена</button>
                                </form>

                            <!-- TAB 7: FINANCE & CASH FLOW (ПОД ПАРОЛЕМ АДМИНИСТРАТОРА) -->
                            <% } else if (activeTab === 'finance') { %>
                                <div class="guide-box mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-shield-lock-fill text-success fs-5 me-2"></i>
                                            <h6 class="fw-bold mb-0 text-dark">Справка для менеджера: Финансовый контур (Studio Ledger & Decima)</h6>
                                        </div>
                                        <button class="btn btn-success btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#addTransactionModal">
                                            <i class="bi bi-plus-lg me-1"></i> Добавить проводку
                                        </button>
                                    </div>
                                    <div class="row g-2 small text-muted">
                                        <div class="col-md-4">
                                            <div class="p-2 bg-white rounded border h-100">
                                                <strong class="text-dark d-block mb-1"><span class="step-badge">1</span> Учет доходов (Билеты & Аренда):</strong>
                                                Вносите поступления от продажи билетов, банкетов, бара и заказных рейсов с привязкой к конкретному юридическому лицу.
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="p-2 bg-white rounded border h-100">
                                                <strong class="text-dark d-block mb-1"><span class="step-badge">2</span> Операционные расходы флота:</strong>
                                                Фиксируйте затраты: бункеровка топливом, аренда причалов, зарплата экипажа, гонорары музыкантов и кейтеринг.
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="p-2 bg-white rounded border h-100">
                                                <strong class="text-dark d-block mb-1"><span class="step-badge">3</span> Зимний резерв (Ледостав):</strong>
                                                Контролируйте индикатор «Зимняя подушка» — алгоритм Decima рассчитывает запас на период ноябрь–апрель без кассовых разрывов.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- 4 KPI Cards -->
                                <div class="row g-3 mb-4">
                                    <div class="col-md-3">
                                        <div class="stat-card border-start border-4 border-success shadow-sm">
                                            <span class="text-muted small fw-semibold text-uppercase">Выручка сезона (Доходы)</span>
                                            <h3 class="fw-bold text-success mt-1 mb-1"><%= Number(financeData.totalIncome).toLocaleString('ru-RU') %> ₽</h3>
                                            <small class="text-muted"><i class="bi bi-arrow-up-right text-success"></i> Билеты, бар, аренда</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="stat-card border-start border-4 border-danger shadow-sm">
                                            <span class="text-muted small fw-semibold text-uppercase">Операционные расходы</span>
                                            <h3 class="fw-bold text-danger mt-1 mb-1"><%= Number(financeData.totalExpense).toLocaleString('ru-RU') %> ₽</h3>
                                            <small class="text-muted"><i class="bi bi-arrow-down-right text-danger"></i> Топливо, артисты, экипаж, причал</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="stat-card border-start border-4 border-primary shadow-sm">
                                            <span class="text-muted small fw-semibold text-uppercase">Операционная прибыль</span>
                                            <h3 class="fw-bold text-primary mt-1 mb-1"><%= Number(financeData.netProfit).toLocaleString('ru-RU') %> ₽</h3>
                                            <small class="text-muted">Рентабельность: <strong class="text-dark"><%= financeData.profitMargin %>%</strong></small>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="stat-card border-start border-4 <%= financeData.winterCoveredPercent >= 100 ? 'border-success' : (financeData.winterCoveredPercent >= 50 ? 'border-warning' : 'border-danger') %> shadow-sm">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="text-muted small fw-semibold text-uppercase">Зимний резерв (Decima)</span>
                                                <span class="badge <%= financeData.winterCoveredPercent >= 100 ? 'bg-success' : 'bg-warning text-dark' %>"><%= financeData.winterRunwayMonths %> мес.</span>
                                            </div>
                                            <h3 class="fw-bold text-dark mt-1 mb-1"><%= financeData.winterCoveredPercent %>%</h3>
                                            <div class="progress mb-1" style="height: 6px;">
                                                <div class="progress-bar <%= financeData.winterCoveredPercent >= 100 ? 'bg-success' : (financeData.winterCoveredPercent >= 50 ? 'bg-warning' : 'bg-danger') %>" style="width: <%= financeData.winterCoveredPercent %>%"></div>
                                            </div>
                                            <small class="text-muted">Потребность ноябрь–апрель: <strong><%= Number(financeData.winterNeededTotal).toLocaleString('ru-RU') %> ₽</strong></small>
                                        </div>
                                    </div>
                                </div>

                                <!-- Legal Entities & Monthly ДДС -->
                                <div class="row g-4 mb-4">
                                    <!-- Юрлица -->
                                    <div class="col-lg-5">
                                        <div class="card border h-100 shadow-sm">
                                            <div class="card-header bg-white py-3">
                                                <h6 class="fw-bold mb-0"><i class="bi bi-building me-2 text-primary"></i>Распределение по юрлицам & кассам</h6>
                                            </div>
                                            <div class="card-body">
                                                <% Object.keys(financeData.legalEntityStats).forEach(ent => { 
                                                    const st = financeData.legalEntityStats[ent];
                                                %>
                                                    <div class="p-3 mb-3 border rounded bg-light">
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <span class="fw-bold text-dark"><%= ent %></span>
                                                            <span class="badge <%= st.balance >= 0 ? 'bg-success' : 'bg-danger' %>"><%= st.balance >= 0 ? '+' : '' %><%= Number(st.balance).toLocaleString('ru-RU') %> ₽</span>
                                                        </div>
                                                        <div class="d-flex justify-content-between small text-muted mb-1">
                                                            <span>Доходы:</span>
                                                            <span class="fw-semibold text-success">+<%= Number(st.income).toLocaleString('ru-RU') %> ₽</span>
                                                        </div>
                                                        <div class="d-flex justify-content-between small text-muted">
                                                            <span>Расходы:</span>
                                                            <span class="fw-semibold text-danger">-<%= Number(st.expense).toLocaleString('ru-RU') %> ₽</span>
                                                        </div>
                                                    </div>
                                                <% }); %>
                                                
                                                <div class="alert alert-light border small text-muted mb-0">
                                                    <i class="bi bi-info-circle me-1"></i> Разделение по юрлицам позволяет точно распределять билетную выручку Ticketland и расчеты по договорам аренды судна.
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Помесячный ДДС (Cash Flow) -->
                                    <div class="col-lg-7">
                                        <div class="card border h-100 shadow-sm">
                                            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                                <h6 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow me-2 text-success"></i>Движение Денежных Средств (ДДС по месяцам)</h6>
                                                <span class="badge bg-light text-dark border">Сезон 2026</span>
                                            </div>
                                            <div class="card-body p-0">
                                                <div class="table-responsive">
                                                    <table class="table table-hover align-middle mb-0">
                                                        <thead class="table-light small">
                                                            <tr>
                                                                <th>Месяц</th>
                                                                <th class="text-end">Поступления</th>
                                                                <th class="text-end">Выплаты</th>
                                                                <th class="text-end">Сальдо за месяц</th>
                                                                <th class="text-center">Статус</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <% 
                                                            const sortedMonths = Object.keys(financeData.monthlyStats).sort();
                                                            sortedMonths.forEach(m => { 
                                                                const ms = financeData.monthlyStats[m];
                                                            %>
                                                                <tr>
                                                                    <td class="fw-semibold"><%= m %></td>
                                                                    <td class="text-end text-success fw-semibold">+<%= Number(ms.income).toLocaleString('ru-RU') %> ₽</td>
                                                                    <td class="text-end text-danger fw-semibold">-<%= Number(ms.expense).toLocaleString('ru-RU') %> ₽</td>
                                                                    <td class="text-end fw-bold <%= ms.balance >= 0 ? 'text-primary' : 'text-danger' %>">
                                                                        <%= ms.balance >= 0 ? '+' : '' %><%= Number(ms.balance).toLocaleString('ru-RU') %> ₽
                                                                    </td>
                                                                    <td class="text-center">
                                                                        <% if (ms.balance >= 0) { %>
                                                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Профицит</span>
                                                                        <% } else { %>
                                                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Дефицит</span>
                                                                        <% } %>
                                                                    </td>
                                                                </tr>
                                                            <% }); %>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Реестр финансовых проводок -->
                                <div class="card border shadow-sm">
                                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                        <h6 class="fw-bold mb-0"><i class="bi bi-journal-text me-2 text-dark"></i>Журнал финансовых операций (<%= financeData.transactions.length %>)</h6>
                                        <button class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#addTransactionModal">
                                            <i class="bi bi-plus-lg me-1"></i> Добавить операцию
                                        </button>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light small">
                                                    <tr>
                                                        <th style="width: 12%;">Дата</th>
                                                        <th style="width: 18%;">Юрлицо</th>
                                                        <th style="width: 20%;">Статья / Категория</th>
                                                        <th style="width: 30%;">Назначение / Описание</th>
                                                        <th style="width: 15%;" class="text-end">Сумма</th>
                                                        <th style="width: 5%;" class="text-center"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (financeData.transactions.length === 0) { %>
                                                        <tr>
                                                            <td colspan="6" class="text-center py-4 text-muted">Операций пока нет. Нажмите «Добавить операцию», чтобы внести первую запись.</td>
                                                        </tr>
                                                    <% } else { %>
                                                        <% financeData.transactions.forEach(t => { %>
                                                            <tr>
                                                                <td class="text-muted small"><%= t.transaction_date %></td>
                                                                <td class="small fw-semibold"><%= t.legal_entity %></td>
                                                                <td>
                                                                    <% if (t.type === 'income') { %>
                                                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                                            <i class="bi bi-arrow-up-circle me-1"></i><%= t.category %>
                                                                        </span>
                                                                    <% } else { %>
                                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                                            <i class="bi bi-arrow-down-circle me-1"></i><%= t.category %>
                                                                        </span>
                                                                    <% } %>
                                                                </td>
                                                                <td class="small"><%= t.description || '—' %></td>
                                                                <td class="text-end fw-bold <%= t.type === 'income' ? 'text-success' : 'text-danger' %>">
                                                                    <%= t.type === 'income' ? '+' : '-' %><%= Number(t.amount).toLocaleString('ru-RU') %> ₽
                                                                </td>
                                                                <td class="text-center">
                                                                    <form action="/api/finance/transaction/delete/<%= t.id %>" method="POST" onsubmit="return confirm('Удалить эту финансовую операцию?');">
                                                                        <input type="hidden" name="domain_id" value="<%= currentDomain.id %>">
                                                                        <button type="submit" class="btn btn-link text-danger p-0" title="Удалить"><i class="bi bi-trash"></i></button>
                                                                    </form>
                                                                </td>
                                                            </tr>
                                                        <% }); %>
                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                            <!-- TAB 8: RENT CALCULATOR & LEADS -->
                            <% } else if (activeTab === 'calc') { %>
                                <div class="guide-box mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-calculator-fill text-primary fs-5 me-2"></i>
                                            <h6 class="fw-bold mb-0 text-dark">Справка для менеджера: Модуль аренды теплохода (IDA Organizer Calc)</h6>
                                        </div>
                                        <a href="/rent" target="_blank" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> Открыть калькулятор на сайте
                                        </a>
                                    </div>
                                    <div class="row g-2 small text-muted">
                                        <div class="col-md-4">
                                            <div class="p-2 bg-white rounded border h-100">
                                                <strong class="text-dark d-block mb-1"><span class="step-badge">1</span> Настройка тарифной сетки:</strong>
                                                Задайте почасовые ставки (День, Вечер, Ночной развод мостов), стоимость фуршета/банкета на персону и доп. услуги (диджей, ведущий, уборка).
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="p-2 bg-white rounded border h-100">
                                                <strong class="text-dark d-block mb-1"><span class="step-badge">2</span> Расчет сметы клиенту:</strong>
                                                Используйте симулятор справа для мгновенного расчета стоимости прямо во время телефонного звонка клиента с учетом всех опций.
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="p-2 bg-white rounded border h-100">
                                                <strong class="text-dark d-block mb-1"><span class="step-badge">3</span> Воронка заявок (Лиды):</strong>
                                                Обрабатывайте входящие брони в таблице заявок, меняйте статусы («В работе», «Подтверждена») и связывайтесь с заказчиками в 1 клик.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-4 mb-4">
                                    <!-- Interactive Simulator -->
                                    <div class="col-lg-6">
                                        <div class="card border shadow-sm h-100">
                                            <div class="card-header bg-white py-3">
                                                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-sliders2 me-2"></i>Интерактивный симулятор сметы</h6>
                                            </div>
                                            <div class="card-body">
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Теплоход & Тарифный период</label>
                                                    <select id="simBoat" class="form-select form-select-sm" onchange="recalculateSimulator()">
                                                        <option value="day"><%= calcSettings.boat_name %> (Дневной тариф — <%= Number(calcSettings.hourly_rate_day).toLocaleString('ru-RU') %> ₽/час)</option>
                                                        <option value="evening"><%= calcSettings.boat_name %> (Вечерний тариф — <%= Number(calcSettings.hourly_rate_evening).toLocaleString('ru-RU') %> ₽/час)</option>
                                                        <option value="night"><%= calcSettings.boat_name %> (Ночной развод мостов — <%= Number(calcSettings.hourly_rate_night_bridges).toLocaleString('ru-RU') %> ₽/час)</option>
                                                    </select>
                                                </div>
                                                <div class="row g-3 mb-3">
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold">Продолжительность: <span id="simHoursLabel" class="fw-bold text-primary">3</span> ч.</label>
                                                        <input type="range" class="form-range" id="simHours" min="2" max="8" value="3" oninput="recalculateSimulator()">
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold">Количество гостей: <span id="simGuestsLabel" class="fw-bold text-primary">40</span> чел.</label>
                                                        <input type="range" class="form-range" id="simGuests" min="10" max="<%= calcSettings.capacity %>" value="40" oninput="recalculateSimulator()">
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Питание на борту</label>
                                                    <div class="d-flex gap-3">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio" name="simCatering" id="catNone" value="none" onchange="recalculateSimulator()">
                                                            <label class="form-check-label small" for="catNone">Без питания</label>
                                                        </div>
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio" name="simCatering" id="catBuffet" value="buffet" checked onchange="recalculateSimulator()">
                                                            <label class="form-check-label small" for="catBuffet">Фуршет (<%= Number(calcSettings.buffet_price_per_person).toLocaleString('ru-RU') %> ₽/чел)</label>
                                                        </div>
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio" name="simCatering" id="catBanquet" value="banquet" onchange="recalculateSimulator()">
                                                            <label class="form-check-label small" for="catBanquet">Банкет (<%= Number(calcSettings.banquet_price_per_person).toLocaleString('ru-RU') %> ₽/чел)</label>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Опции программы</label>
                                                    <div class="form-check form-switch mb-1">
                                                        <input class="form-check-input" type="checkbox" id="simDj" checked onchange="recalculateSimulator()">
                                                        <label class="form-check-label small" for="simDj">Звуковое оборудование + DJ (+<%= Number(calcSettings.dj_sound_price).toLocaleString('ru-RU') %> ₽)</label>
                                                    </div>
                                                    <div class="form-check form-switch mb-1">
                                                        <input class="form-check-input" type="checkbox" id="simHost" onchange="recalculateSimulator()">
                                                        <label class="form-check-label small" for="simHost">Ведущий мероприятия (+<%= Number(calcSettings.host_price).toLocaleString('ru-RU') %> ₽)</label>
                                                    </div>
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox" id="simBand" onchange="recalculateSimulator()">
                                                        <label class="form-check-label small" for="simBand">Живая рок-группа / трибьют (+<%= Number(calcSettings.live_band_price).toLocaleString('ru-RU') %> ₽)</label>
                                                    </div>
                                                </div>

                                                <div class="p-3 bg-light rounded border mt-3">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <span class="fw-bold text-dark">Расчетная смета:</span>
                                                        <span class="h4 fw-bold text-primary mb-0" id="simTotalDisplay">0 ₽</span>
                                                    </div>
                                                    <small class="text-muted d-block mt-1" id="simBreakdown"></small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Settings Form -->
                                    <div class="col-lg-6">
                                        <div class="card border shadow-sm h-100">
                                            <div class="card-header bg-white py-3">
                                                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-gear-fill me-2 text-secondary"></i>Тарифные ставки для <%= currentDomain.name %></h6>
                                            </div>
                                            <div class="card-body">
                                                <form action="/api/calc/settings" method="POST">
                                                    <input type="hidden" name="domain_id" value="<%= currentDomain.id %>">
                                                    <div class="row g-2 mb-3">
                                                        <div class="col-md-8">
                                                            <label class="form-label small fw-semibold">Название судна</label>
                                                            <input type="text" class="form-control form-control-sm" name="boat_name" value="<%= calcSettings.boat_name %>" required>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label small fw-semibold">Вместимость (чел.)</label>
                                                            <input type="number" class="form-control form-control-sm" name="capacity" value="<%= calcSettings.capacity %>" required>
                                                        </div>
                                                    </div>

                                                    <div class="row g-2 mb-3">
                                                        <div class="col-md-4">
                                                            <label class="form-label small fw-semibold">День (до 18:00) ₽/ч</label>
                                                            <input type="number" class="form-control form-control-sm" name="hourly_rate_day" value="<%= calcSettings.hourly_rate_day %>" required>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label small fw-semibold">Вечер (18-23) ₽/ч</label>
                                                            <input type="number" class="form-control form-control-sm" name="hourly_rate_evening" value="<%= calcSettings.hourly_rate_evening %>" required>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label small fw-semibold">Мосты (ночь) ₽/ч</label>
                                                            <input type="number" class="form-control form-control-sm" name="hourly_rate_night_bridges" value="<%= calcSettings.hourly_rate_night_bridges %>" required>
                                                        </div>
                                                    </div>

                                                    <div class="row g-2 mb-3">
                                                        <div class="col-md-6">
                                                            <label class="form-label small fw-semibold">Фуршет (₽ на человека)</label>
                                                            <input type="number" class="form-control form-control-sm" name="buffet_price_per_person" value="<%= calcSettings.buffet_price_per_person %>" required>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label small fw-semibold">Банкет (₽ на человека)</label>
                                                            <input type="number" class="form-control form-control-sm" name="banquet_price_per_person" value="<%= calcSettings.banquet_price_per_person %>" required>
                                                        </div>
                                                    </div>

                                                    <div class="row g-2 mb-3">
                                                        <div class="col-md-4">
                                                            <label class="form-label small fw-semibold">Звук + DJ (₽)</label>
                                                            <input type="number" class="form-control form-control-sm" name="dj_sound_price" value="<%= calcSettings.dj_sound_price %>" required>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label small fw-semibold">Ведущий (₽)</label>
                                                            <input type="number" class="form-control form-control-sm" name="host_price" value="<%= calcSettings.host_price %>" required>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label small fw-semibold">Рок-группа (₽)</label>
                                                            <input type="number" class="form-control form-control-sm" name="live_band_price" value="<%= calcSettings.live_band_price %>" required>
                                                        </div>
                                                    </div>

                                                    <div class="row g-2 mb-3">
                                                        <div class="col-md-6">
                                                            <label class="form-label small fw-semibold">Клининг / уборка (₽)</label>
                                                            <input type="number" class="form-control form-control-sm" name="cleaning_fee" value="<%= calcSettings.cleaning_fee %>" required>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label small fw-semibold">Мин. заказ (часов)</label>
                                                            <input type="number" class="form-control form-control-sm" name="min_hours" value="<%= calcSettings.min_hours %>" required>
                                                        </div>
                                                    </div>

                                                    <button type="submit" class="btn btn-primary btn-sm px-4">Сохранить тарифы</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Входящие заявки на аренду (Лиды) -->
                                <div class="card border shadow-sm">
                                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                        <h6 class="fw-bold mb-0"><i class="bi bi-inbox-fill me-2 text-primary"></i>Входящие заявки на аренду судна (<%= rentLeads.length %>)</h6>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light small">
                                                    <tr>
                                                        <th>Дата заявки</th>
                                                        <th>Заказчик</th>
                                                        <th>Контакты</th>
                                                        <th>Дата & Время события</th>
                                                        <th>Гости & Часы</th>
                                                        <th>Питание & Опции</th>
                                                        <th class="text-end">Смета</th>
                                                        <th class="text-center">Статус</th>
                                                        <th class="text-end">Действие</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (rentLeads.length === 0) { %>
                                                        <tr>
                                                            <td colspan="9" class="text-center py-4 text-muted">Заявок пока нет. Клиенты могут оставлять расчет на странице калькулятора.</td>
                                                        </tr>
                                                    <% } else { %>
                                                        <% rentLeads.forEach(lead => { %>
                                                            <tr>
                                                                <td class="small text-muted"><%= (lead.created_at || '').substring(0, 16) %></td>
                                                                <td class="fw-bold small"><%= lead.customer_name %></td>
                                                                <td class="small">
                                                                    <a href="tel:<%= lead.customer_phone %>" class="text-decoration-none fw-semibold"><%= lead.customer_phone %></a>
                                                                    <% if (lead.customer_email) { %><br><small class="text-muted"><%= lead.customer_email %></small><% } %>
                                                                </td>
                                                                <td class="small">
                                                                    <strong><%= lead.event_date || 'Не указана' %></strong>
                                                                    <% if (lead.start_time) { %><span class="text-muted">в <%= lead.start_time %></span><% } %>
                                                                </td>
                                                                <td class="small">
                                                                    <span class="badge bg-light text-dark border"><%= lead.guests_count %> чел.</span>
                                                                    <span class="badge bg-light text-dark border"><%= lead.duration_hours %> ч.</span>
                                                                </td>
                                                                <td class="small">
                                                                    <span class="badge bg-info-subtle text-info border border-info-subtle"><%= lead.catering_type %></span>
                                                                    <% if (lead.notes) { %><br><small class="text-muted" title="<%= lead.notes %>"><%= lead.notes.length > 35 ? lead.notes.substring(0, 35) + '...' : lead.notes %></small><% } %>
                                                                </td>
                                                                <td class="text-end fw-bold text-primary">
                                                                    <%= Number(lead.total_estimated_price).toLocaleString('ru-RU') %> ₽
                                                                </td>
                                                                <td class="text-center">
                                                                    <% if (lead.status === 'new') { %>
                                                                        <span class="badge bg-warning text-dark">Новая</span>
                                                                    <% } else if (lead.status === 'contacted') { %>
                                                                        <span class="badge bg-info text-dark">В работе</span>
                                                                    <% } else if (lead.status === 'confirmed') { %>
                                                                        <span class="badge bg-success">Подтверждена</span>
                                                                    <% } else { %>
                                                                        <span class="badge bg-secondary">Отклонена</span>
                                                                    <% } %>
                                                                </td>
                                                                <td class="text-end">
                                                                    <form action="/api/calc/lead/status/<%= lead.id %>" method="POST" class="d-inline">
                                                                        <input type="hidden" name="domain_id" value="<%= currentDomain.id %>">
                                                                        <select name="status" class="form-select form-select-sm d-inline-block w-auto" onchange="this.form.submit()">
                                                                            <option value="new" <%= lead.status === 'new' ? 'selected' : '' %>>Новая</option>
                                                                            <option value="contacted" <%= lead.status === 'contacted' ? 'selected' : '' %>>В работе</option>
                                                                            <option value="confirmed" <%= lead.status === 'confirmed' ? 'selected' : '' %>>Подтверждена</option>
                                                                            <option value="cancelled" <%= lead.status === 'cancelled' ? 'selected' : '' %>>Отклонена</option>
                                                                        </select>
                                                                    </form>
                                                                </td>
                                                            </tr>
                                                        <% }); %>
                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            <% } else if (activeTab === 'widget') { %>
                                <!-- TAB: WIDGET & SCHEMES -->
                                <div class="guide-box mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-diagram-3-fill text-success fs-5 me-2"></i>
                                            <h6 class="fw-bold mb-0 text-dark">Справка для менеджера: Автономный SVG-виджет & Схемы рассадки</h6>
                                        </div>
                                        <span class="badge bg-success px-3 py-2"><i class="bi bi-shield-check me-1"></i> 100% Direct Sale</span>
                                    </div>
                                    <div class="row g-2 small text-muted">
                                        <div class="col-md-4">
                                            <div class="p-2 bg-white rounded border h-100">
                                                <strong class="text-dark d-block mb-1"><span class="step-badge">1</span> Мастер-переключатель:</strong>
                                                Одной кнопкой переключайте весь сайт на наш SVG-виджет (100% выручки без комиссий) или возвращайте Ticketland как резервный канал.
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="p-2 bg-white rounded border h-100">
                                                <strong class="text-dark d-block mb-1"><span class="step-badge">2</span> Интерактивная схема палубы:</strong>
                                                Виджет автоматически отображает зоны (VIP-нос, сцена, бар, верхняя палуба), блокирует места на 15 мин и передает заказ в кассу.
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="p-2 bg-white rounded border h-100">
                                                <strong class="text-dark d-block mb-1"><span class="step-badge">3</span> Встраивание & Код:</strong>
                                                Скопируйте готовый HTML-сниппет виджета для размещения на любой промо-странице или во внешних блоках анонсов.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <% const firstSession = (sessions && sessions.length > 0) ? sessions[0] : null; %>
                                <% const initialSessionId = firstSession ? firstSession.id : 1; %>

                                <!-- MASTER SWITCH CARD: NATIVE VS TICKETLAND -->
                                <div class="card border-0 shadow-sm mb-4 bg-light-subtle border-start border-4 border-primary">
                                    <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
                                        <div>
                                            <h6 class="fw-bold mb-1 text-dark"><i class="bi bi-toggles2 text-primary me-2"></i>Мастер-переключатель виджетов сайта</h6>
                                            <p class="small text-muted mb-0">Мгновенно переключает все страницы и мероприятия домена <strong><%= currentDomain.name %></strong> между нашим прямым SVG-виджетом и Ticketland.</p>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <form action="/api/domain/switch-all-widgets" method="POST" onsubmit="return confirm('Включить прямой SVG-виджет со схемой теплохода для всех страниц сайта?');">
                                                <input type="hidden" name="domain_id" value="<%= currentDomain.id %>">
                                                <input type="hidden" name="mode" value="native">
                                                <button type="submit" class="btn btn-success btn-sm px-3 fw-bold shadow-sm">
                                                    <i class="bi bi-lightning-charge-fill me-1"></i> Включить наш SVG-виджет (100% выручки)
                                                </button>
                                            </form>
                                            <form action="/api/domain/switch-all-widgets" method="POST" onsubmit="return confirm('Переключить все страницы обратно на виджет Ticketland?');">
                                                <input type="hidden" name="domain_id" value="<%= currentDomain.id %>">
                                                <input type="hidden" name="mode" value="ticketland">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm px-3">
                                                    <i class="bi bi-ticket-perforated me-1"></i> Ticketland (Резерв)
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-4">
                                    <!-- Controls & Actions Column -->
                                    <div class="col-lg-4">
                                        <div class="card shadow-sm border-0 mb-4">
                                            <div class="card-header bg-white py-3 border-bottom">
                                                <h6 class="mb-0 fw-bold"><i class="bi bi-sliders me-2 text-primary"></i>Параметры рейса для виджета</h6>
                                            </div>
                                            <div class="card-body">
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Выберите рейс для предпросмотра</label>
                                                    <select id="widgetSessionSelect" class="form-select form-select-sm" onchange="updateWidgetPreview(this.value)">
                                                        <% if (!sessions || sessions.length === 0) { %>
                                                            <option value="1">Тестовый рейс (по умолчанию)</option>
                                                        <% } else { %>
                                                            <% sessions.forEach((s, idx) => { %>
                                                                <option value="<%= s.id %>" <%= idx === 0 ? 'selected' : '' %>>
                                                                    <%= s.start_time %> — <%= s.event_title || 'Концерт' %> (<%= s.venue_name || 'Теплоход' %>)
                                                                </option>
                                                            <% }); %>
                                                        <% } %>
                                                    </select>
                                                </div>

                                                <div class="d-flex gap-2 mb-3">
                                                    <a id="openWidgetStandaloneBtn" href="/widget/embed?session_id=<%= initialSessionId %>" target="_blank" class="btn btn-outline-primary btn-sm flex-grow-1">
                                                        <i class="bi bi-box-arrow-up-right me-1"></i> Открыть во весь экран
                                                    </a>
                                                    <button class="btn btn-outline-secondary btn-sm" onclick="refreshWidgetPreview()" title="Обновить предпросмотр">
                                                        <i class="bi bi-arrow-repeat"></i>
                                                    </button>
                                                </div>

                                                <hr class="my-3">

                                                <h6 class="fw-bold small text-uppercase text-muted mb-2">Быстрое встраивание на страницу</h6>
                                                <form action="/api/widget/embed-into-page" method="POST" id="embedPageForm">
                                                    <input type="hidden" name="domain_id" value="<%= currentDomain.id %>">
                                                    <input type="hidden" name="session_id" id="embedSessionIdInput" value="<%= initialSessionId %>">
                                                    
                                                    <div class="mb-3">
                                                        <label class="form-label small">Целевая страница сайта</label>
                                                        <select name="page_id" class="form-select form-select-sm" required>
                                                            <% if (!pages || pages.length === 0) { %>
                                                                <option value="" disabled>Нет доступных страниц</option>
                                                            <% } else { %>
                                                                <% pages.forEach(p => { %>
                                                                    <option value="<%= p.id %>">
                                                                        <%= p.title %> (<%= p.slug === '/' ? 'Главная /' : '/' + p.slug + '/' %>)
                                                                    </option>
                                                                <% }); %>
                                                            <% } %>
                                                        </select>
                                                    </div>

                                                    <button type="submit" class="btn btn-success btn-sm w-100 fw-semibold">
                                                        <i class="bi bi-magic me-1"></i> Встроить наш виджет на страницу
                                                    </button>
                                                </form>
                                            </div>
                                        </div>

                                        <!-- Embed Code Generator Card -->
                                        <div class="card shadow-sm border-0">
                                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                                                <h6 class="mb-0 fw-bold"><i class="bi bi-code-slash me-2 text-info"></i>Код для ручной вставки</h6>
                                                <span class="badge bg-light text-dark border">HTML / JS</span>
                                            </div>
                                            <div class="card-body">
                                                <label class="form-label small fw-semibold">1. Нативный блок (Без Iframe)</label>
                                                <div class="position-relative mb-3">
                                                    <textarea id="nativeWidgetCode" class="form-control font-monospace small bg-light" rows="4" readonly style="font-size: 0.78rem;"><!-- Интерактивная схема теплохода -->
<div class="ship-ticket-widget" data-session-id="<%= initialSessionId %>"></div>
<link rel="stylesheet" href="https://<%= currentDomain.name %>/css/ship_widget.css">
<script src="https://<%= currentDomain.name %>/js/ship_widget.js"></script></textarea>
                                                    <button class="btn btn-sm btn-outline-primary position-absolute top-0 end-0 m-1 py-0 px-2" onclick="copySnippet('nativeWidgetCode', this)" style="font-size: 0.75rem;">
                                                        <i class="bi bi-clipboard"></i> Копировать
                                                    </button>
                                                </div>

                                                <label class="form-label small fw-semibold">2. Iframe код (для Tilda / сторонних CMS)</label>
                                                <div class="position-relative mb-2">
                                                    <textarea id="iframeWidgetCode" class="form-control font-monospace small bg-light" rows="3" readonly style="font-size: 0.78rem;"><iframe src="https://<%= currentDomain.name %>/widget/embed?session_id=<%= initialSessionId %>" width="100%" height="780" frameborder="0" style="border:none; border-radius:12px; width:100%; min-height:780px;"></iframe></textarea>
                                                    <button class="btn btn-sm btn-outline-primary position-absolute top-0 end-0 m-1 py-0 px-2" onclick="copySnippet('iframeWidgetCode', this)" style="font-size: 0.75rem;">
                                                        <i class="bi bi-clipboard"></i> Копировать
                                                    </button>
                                                </div>
                                                <small class="text-muted d-block" style="font-size: 0.75rem;">Виджет автоматически адаптируется под экраны мобильных телефонов и планшетов.</small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Live Simulator Column -->
                                    <div class="col-lg-8">
                                        <div class="card shadow-sm border-0">
                                            <div class="card-header bg-dark text-white py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-display text-info"></i>
                                                    <span class="fw-bold small">Интерактивный симулятор виджета</span>
                                                    <span class="badge bg-secondary" id="simDeviceLabel">Desktop</span>
                                                </div>
                                                <div class="d-flex align-items-center gap-1">
                                                    <button class="btn btn-sm btn-outline-light py-0 px-2 active" onclick="setWidgetSimMode('100%', 'Desktop', this)">
                                                        <i class="bi bi-laptop"></i> ПК
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-light py-0 px-2" onclick="setWidgetSimMode('768px', 'Tablet', this)">
                                                        <i class="bi bi-tablet"></i> Планшет
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-light py-0 px-2" onclick="setWidgetSimMode('390px', 'Mobile', this)">
                                                        <i class="bi bi-phone"></i> Телефон
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="card-body p-2 bg-secondary-subtle d-flex justify-content-center">
                                                <div id="simFrameWrapper" style="width: 100%; transition: width 0.3s ease; max-width: 100%;">
                                                    <iframe id="widgetPreviewIframe" src="/widget/embed?session_id=<%= initialSessionId %>" style="width: 100%; height: 740px; border: 1px solid #cbd5e1; border-radius: 8px; background: #0f172a; display: block;" title="Widget Preview"></iframe>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Modal: Добавить финансовую проводку -->
    <div class="modal fade" id="addTransactionModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/finance/transaction" method="POST">
                    <input type="hidden" name="domain_id" value="<%= currentDomain.id %>">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">Новая финансовая проводка</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Тип операции</label>
                            <select class="form-select" name="type" id="transType" onchange="updateCategories()" required>
                                <option value="income">Поступление (Доход)</option>
                                <option value="expense" selected>Выплата (Расход)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Юридическое лицо</label>
                            <select class="form-select" name="legal_entity" required>
                                <option value="ООО «Акватур»">ООО «Акватур» (Рок Хит Нева)</option>
                                <option value="ООО «Акватория Звука»">ООО «Акватория Звука»</option>
                                <option value="ИП Организатор">ИП Организатор</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Категория / Статья</label>
                            <select class="form-select" name="category" id="transCategory" required>
                                <!-- Populated via JS -->
                            </select>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Сумма (₽)</label>
                                <input type="number" class="form-control" name="amount" required placeholder="50000">
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Дата операции</label>
                                <input type="date" class="form-control" name="transaction_date" required value="<%= new Date().toISOString().substring(0, 10) %>">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Назначение платежа / Комментарий</label>
                            <textarea class="form-control" name="description" rows="2" placeholder="Номер акта, договора или описание статьи..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                        <button type="submit" class="btn btn-success">Сохранить операцию</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: Создать рекламную кампанию (UTM / Маркетинг) -->
    <div class="modal fade" id="addCampaignModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/marketing/campaign/save" method="POST">
                    <input type="hidden" name="domain_id" value="<%= currentDomain.id %>">
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title fw-bold"><i class="bi bi-megaphone me-2 text-danger"></i>Новая рекламная кампания</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Название кампании</label>
                            <input type="text" class="form-control" name="title" required placeholder="Например: Яндекс.Директ Поиск (Рок на Неве)">
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-semibold">utm_source (Источник)</label>
                                <input type="text" class="form-control font-monospace" name="utm_source" required placeholder="yandex, vk, tg, qr_hotel">
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold">utm_medium (Канал)</label>
                                <input type="text" class="form-control font-monospace" name="utm_medium" value="cpc" placeholder="cpc, post, offline, qr">
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-semibold">utm_campaign (Кампания)</label>
                                <input type="text" class="form-control font-monospace" name="utm_campaign" placeholder="search_rock, spring_sale">
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Промокод (если есть)</label>
                                <input type="text" class="form-control font-monospace text-uppercase" name="promo_code" placeholder="ROCK10">
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-8">
                                <label class="form-label small fw-semibold">Посадочная страница</label>
                                <input type="text" class="form-control" name="target_url" value="/" placeholder="/ или /events/rock-hit-neva">
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-semibold">Бюджет (₽)</label>
                                <input type="number" class="form-control" name="budget" placeholder="15000">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Заметки / Описание цели</label>
                            <textarea class="form-control" name="notes" rows="2" placeholder="Планируемый охват, даты проведения, ответственный подрядчик..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-check-lg me-1"></i>Сохранить кампанию</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Category options for Finance
        const categories = {
            income: [
                'Билетные продажи',
                'Аренда под спецобслуживание',
                'Бар на борту',
                'Спонсорские пакеты',
                'Прочее поступление'
            ],
            expense: [
                'Гонорары артистам',
                'Топливо',
                'Аренда причала',
                'Зарплата экипажа',
                'Техобслуживание судна',
                'Зимняя стоянка (аванс)',
                'Комиссия билетных операторов',
                'Маркетинг & Реклама',
                'Прочие расходы'
            ]
        };

        function updateCategories() {
            const type = document.getElementById('transType').value;
            const select = document.getElementById('transCategory');
            select.innerHTML = '';
            (categories[type] || []).forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat;
                opt.textContent = cat;
                select.appendChild(opt);
            });
        }
        if (document.getElementById('transType')) {
            updateCategories();
        }

        // Rent Simulator Calculation
        const calcConfig = {
            hourlyDay: <%= (calcSettings && calcSettings.hourly_rate_day) || 15000 %>,
            hourlyEvening: <%= (calcSettings && calcSettings.hourly_rate_evening) || 20000 %>,
            hourlyNight: <%= (calcSettings && calcSettings.hourly_rate_night_bridges) || 28000 %>,
            buffetPerPerson: <%= (calcSettings && calcSettings.buffet_price_per_person) || 2200 %>,
            banquetPerPerson: <%= (calcSettings && calcSettings.banquet_price_per_person) || 3500 %>,
            djPrice: <%= (calcSettings && calcSettings.dj_sound_price) || 15000 %>,
            hostPrice: <%= (calcSettings && calcSettings.host_price) || 25000 %>,
            bandPrice: <%= (calcSettings && calcSettings.live_band_price) || 45000 %>,
            cleaningFee: <%= (calcSettings && calcSettings.cleaning_fee) || 5000 %>
        };

        function recalculateSimulator() {
            const hoursEl = document.getElementById('simHours');
            const guestsEl = document.getElementById('simGuests');
            if (!hoursEl || !guestsEl) return;

            const hours = parseInt(hoursEl.value) || 2;
            const guests = parseInt(guestsEl.value) || 20;

            document.getElementById('simHoursLabel').textContent = hours;
            document.getElementById('simGuestsLabel').textContent = guests;

            const boatMode = document.getElementById('simBoat').value;
            let hourlyRate = calcConfig.hourlyDay;
            if (boatMode === 'evening') hourlyRate = calcConfig.hourlyEvening;
            if (boatMode === 'night') hourlyRate = calcConfig.hourlyNight;

            const rentCost = hourlyRate * hours;

            let cateringCost = 0;
            const cateringType = document.querySelector('input[name="simCatering"]:checked').value;
            if (cateringType === 'buffet') cateringCost = calcConfig.buffetPerPerson * guests;
            if (cateringType === 'banquet') cateringCost = calcConfig.banquetPerPerson * guests;

            let optionsCost = 0;
            if (document.getElementById('simDj').checked) optionsCost += calcConfig.djPrice;
            if (document.getElementById('simHost').checked) optionsCost += calcConfig.hostPrice;
            if (document.getElementById('simBand').checked) optionsCost += calcConfig.bandPrice;

            const total = rentCost + cateringCost + optionsCost + calcConfig.cleaningFee;

            document.getElementById('simTotalDisplay').textContent = total.toLocaleString('ru-RU') + ' ₽';
            document.getElementById('simBreakdown').textContent = `Аренда (${hours}ч): ${rentCost.toLocaleString('ru-RU')} ₽ + Питание: ${cateringCost.toLocaleString('ru-RU')} ₽ + Опции: ${optionsCost.toLocaleString('ru-RU')} ₽ + Клининг: ${calcConfig.cleaningFee.toLocaleString('ru-RU')} ₽`;
        }
        if (document.getElementById('simHours')) {
            recalculateSimulator();
        }
        function addGatewayCard(domainId) {
            const container = document.getElementById('gatewaysContainer' + domainId);
            const count = container.querySelectorAll('.gateway-item').length + 1;
            const nextId = Date.now();
            
            const card = document.createElement('div');
            card.className = 'card bg-light border p-3 gateway-item';
            card.setAttribute('data-id', nextId);
            card.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-semibold text-primary small">Кассовый шлюз #<span class="gw-num">${count}</span></span>
                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeGatewayCard(this)">Удалить</button>
                </div>
                <input type="hidden" name="gateway_id" value="${nextId}">
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Название юр. лица / шлюза</label>
                    <input type="text" class="form-control form-control-sm" name="gateway_name" value="Шлюз ${count}" required>
                </div>
                <div>
                    <label class="form-label small fw-semibold mb-1">JS-код вызова шлюза (TLConf / SDK)</label>
                    <textarea class="form-control form-control-sm font-monospace" name="gateway_code" rows="3"></textarea>
                </div>
            `;
            container.appendChild(card);
        }

        function removeGatewayCard(btn) {
            const card = btn.closest('.gateway-item');
            const container = card.parentElement;
            if (container.querySelectorAll('.gateway-item').length <= 1) {
                alert('У домена должен оставаться хотя бы один кассовый шлюз.');
                return;
            }
            card.remove();
            container.querySelectorAll('.gateway-item').forEach((item, index) => {
                const numSpan = item.querySelector('.gw-num');
                if (numSpan) numSpan.textContent = index + 1;
            });
        }

        function onTemplateChange(sel, prefix) {
            const opt = sel.options[sel.selectedIndex];
            if (!opt || !opt.value) return;
            const pVipNose = opt.getAttribute('data-vip-nose');
            const pVipScene = opt.getAttribute('data-vip-scene');
            const pMainSalon = opt.getAttribute('data-main-salon');
            const pUpperClosed = opt.getAttribute('data-upper-closed');
            const pUpperOpen = opt.getAttribute('data-upper-open');
            const quota = opt.getAttribute('data-quota');
            const venueId = opt.getAttribute('data-venue-id');

            if (pVipNose) {
                const el = document.getElementById(prefix + '_price_vip_nose');
                if (el) el.value = pVipNose;
            }
            if (pVipScene) {
                const el = document.getElementById(prefix + '_price_vip_scene');
                if (el) el.value = pVipScene;
            }
            if (pMainSalon) {
                const el = document.getElementById(prefix + '_price_main_salon');
                if (el) el.value = pMainSalon;
            }
            if (pUpperClosed) {
                const el = document.getElementById(prefix + '_price_upper_closed');
                if (el) el.value = pUpperClosed;
            }
            if (pUpperOpen) {
                const el = document.getElementById(prefix + '_price_upper_open');
                if (el) el.value = pUpperOpen;
                const minEl = document.getElementById(prefix + '_min_price');
                if (minEl) minEl.value = pUpperOpen;
            }
            if (quota !== null && quota !== undefined) {
                const el = document.getElementById(prefix + '_ticketland_quota');
                if (el) el.value = quota;
            }
            if (venueId) {
                const vEl = document.getElementById(prefix + '_venue_id');
                if (vEl && vEl.value != venueId) vEl.value = venueId;
            }
        }

        function onVenueChange(sel, prefix) {
            const vId = sel.value;
            const tplSel = document.getElementById(prefix + '_template_id');
            if (!tplSel) return;
            for (let i = 0; i < tplSel.options.length; i++) {
                if (tplSel.options[i].getAttribute('data-venue-id') == vId) {
                    tplSel.selectedIndex = i;
                    onTemplateChange(tplSel, prefix);
                    break;
                }
            }
        }

        // Marketing Quick UTM Builder
        function updateQuickUtmLink() {
            const path = document.getElementById('gen_path') ? document.getElementById('gen_path').value : '/';
            const src = document.getElementById('gen_src') ? document.getElementById('gen_src').value : 'yandex';
            const med = document.getElementById('gen_med') ? document.getElementById('gen_med').value : 'cpc';
            const camp = document.getElementById('gen_camp') ? document.getElementById('gen_camp').value : 'search';
            const promo = document.getElementById('gen_promo') ? document.getElementById('gen_promo').value.trim() : '';
            
            const domain = window.location.origin;
            let url = domain + (path.startsWith('/') ? path : '/' + path);
            url += `?utm_source=${encodeURIComponent(src)}&utm_medium=${encodeURIComponent(med)}&utm_campaign=${encodeURIComponent(camp)}`;
            if (promo) {
                url += `&promo=${encodeURIComponent(promo)}`;
            }
            const resEl = document.getElementById('gen_result');
            if (resEl) resEl.value = url;
        }

        function copyQuickUtmLink() {
            const resEl = document.getElementById('gen_result');
            if (!resEl) return;
            resEl.select();
            navigator.clipboard.writeText(resEl.value).then(() => {
                const btn = event.currentTarget;
                const oldHtml = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check-lg text-success"></i> Скопировано!';
                setTimeout(() => { btn.innerHTML = oldHtml; }, 2000);
            }).catch(err => {
                alert('Ссылка выделена, нажмите Ctrl+C');
            });
        }

        // Widget Simulator Helpers
        function updateWidgetPreview(sessionId) {
            const iframe = document.getElementById('widgetPreviewIframe');
            if (iframe) {
                iframe.src = '/widget/embed?session_id=' + sessionId;
            }
            const openBtn = document.getElementById('openWidgetStandaloneBtn');
            if (openBtn) {
                openBtn.href = '/widget/embed?session_id=' + sessionId;
            }
            const embedInput = document.getElementById('embedSessionIdInput');
            if (embedInput) {
                embedInput.value = sessionId;
            }
            const currentDomainName = '<%= currentDomain ? currentDomain.name : "spb-peterhof.ru" %>';
            const nativeCodeEl = document.getElementById('nativeWidgetCode');
            if (nativeCodeEl) {
                nativeCodeEl.value = `<!-- Интерактивная схема теплохода -->\n<div class="ship-ticket-widget" data-session-id="${sessionId}"></div>\n<link rel="stylesheet" href="https://${currentDomainName}/css/ship_widget.css">\n<script src="https://${currentDomainName}/js/ship_widget.js"><\/script>`;
            }
            const iframeCodeEl = document.getElementById('iframeWidgetCode');
            if (iframeCodeEl) {
                iframeCodeEl.value = `<iframe src="https://${currentDomainName}/widget/embed?session_id=${sessionId}" width="100%" height="780" frameborder="0" style="border:none; border-radius:12px; width:100%; min-height:780px;"></iframe>`;
            }
        }

        function refreshWidgetPreview() {
            const iframe = document.getElementById('widgetPreviewIframe');
            if (iframe) {
                iframe.src = iframe.src;
            }
        }

        function setWidgetSimMode(width, label, btn) {
            const wrapper = document.getElementById('simFrameWrapper');
            const labelEl = document.getElementById('simDeviceLabel');
            if (wrapper) {
                wrapper.style.width = width;
            }
            if (labelEl) {
                labelEl.textContent = label;
            }
            if (btn && btn.parentElement) {
                btn.parentElement.querySelectorAll('button').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            }
        }

        function copySnippet(textareaId, btn) {
            const el = document.getElementById(textareaId);
            if (!el) return;
            el.select();
            navigator.clipboard.writeText(el.value).then(() => {
                const oldHtml = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check-lg text-success"></i> Скопировано!';
                setTimeout(() => { btn.innerHTML = oldHtml; }, 2000);
            }).catch(() => {
                alert('Текст выделен, нажмите Ctrl+C');
            });
        }
    </script>
</body>
</html>
